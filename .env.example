# ─── TMDb ──────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here

# ─── Reddit ────────────────────────────────────────────────────────────────────
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password

# ─── YouTube ───────────────────────────────────────────────────────────────────
# Path to your OAuth2 client_secret.json from Google Cloud Console
YOUTUBE_CLIENT_SECRET_PATH=config/youtube_client_secret.json
# JSON string of the saved token (for CI/GitHub Actions)
YOUTUBE_TOKEN_JSON=

# ─── TikTok ────────────────────────────────────────────────────────────────────
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_SESSION_COOKIE=your_tiktok_sessionid_cookie
TIKTOK_API_KEY=
TIKTOK_API_SECRET=

# ─── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token
# Comma-separated guild IDs for fast command sync (optional)
DISCORD_GUILD_IDS=123456789,987654321

# ─── SEO / Indexing ────────────────────────────────────────────────────────────
GOOGLE_INDEXING_API_KEY=
BING_INDEXING_API_KEY=

# ─── Site ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://web-umber-six-e1un7z6257.vercel.app
